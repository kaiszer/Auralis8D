<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Deep Navy Surfaces -->
    <Color x:Key="ColorBgPrimary">#0B1120</Color>
    <Color x:Key="ColorBgSecondary">#0F172A</Color>
    <Color x:Key="ColorBgCard">#1E293B</Color>
    <Color x:Key="ColorBgCardHover">#273549</Color>

    <!-- Cool Gray and Silver Borders & Dividers -->
    <Color x:Key="ColorBorder">#334155</Color>
    <Color x:Key="ColorBorderHover">#475569</Color>
    <Color x:Key="ColorSilver">#94A3B8</Color>
    <Color x:Key="ColorSilverBright">#CBD5E1</Color>

    <!-- Vibrant Accents (Medium Blue & Cyan) -->
    <Color x:Key="ColorAccentBlue">#2563EB</Color>
    <Color x:Key="ColorAccentBlueBright">#3B82F6</Color>
    <Color x:Key="ColorAccentCyan">#06B6D4</Color>
    <Color x:Key="ColorAccentCyanGlow">#22D3EE</Color>

    <!-- Typography -->
    <Color x:Key="ColorTextPrimary">#F8FAFC</Color>
    <Color x:Key="ColorTextSecondary">#94A3B8</Color>
    <Color x:Key="ColorTextMuted">#64748B</Color>

    <!-- Solid Color Brushes -->
    <SolidColorBrush x:Key="BrushBgPrimary" Color="{StaticResource ColorBgPrimary}" />
    <SolidColorBrush x:Key="BrushBgSecondary" Color="{StaticResource ColorBgSecondary}" />
    <SolidColorBrush x:Key="BrushBgCard" Color="{StaticResource ColorBgCard}" />
    <SolidColorBrush x:Key="BrushBgCardHover" Color="{StaticResource ColorBgCardHover}" />

    <SolidColorBrush x:Key="BrushBorder" Color="{StaticResource ColorBorder}" />
    <SolidColorBrush x:Key="BrushBorderHover" Color="{StaticResource ColorBorderHover}" />
    <SolidColorBrush x:Key="BrushSilver" Color="{StaticResource ColorSilver}" />
    <SolidColorBrush x:Key="BrushSilverBright" Color="{StaticResource ColorSilverBright}" />

    <SolidColorBrush x:Key="BrushAccentBlue" Color="{StaticResource ColorAccentBlue}" />
    <SolidColorBrush x:Key="BrushAccentBlueBright" Color="{StaticResource ColorAccentBlueBright}" />
    <SolidColorBrush x:Key="BrushAccentCyan" Color="{StaticResource ColorAccentCyan}" />
    <SolidColorBrush x:Key="BrushAccentCyanGlow" Color="{StaticResource ColorAccentCyanGlow}" />

    <SolidColorBrush x:Key="BrushTextPrimary" Color="{StaticResource ColorTextPrimary}" />
    <SolidColorBrush x:Key="BrushTextSecondary" Color="{StaticResource ColorTextSecondary}" />
    <SolidColorBrush x:Key="BrushTextMuted" Color="{StaticResource ColorTextMuted}" />

</ResourceDictionary>
