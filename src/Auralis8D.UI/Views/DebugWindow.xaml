<Window x:Class="Auralis8D.UI.Views.DebugWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:viewmodels="clr-namespace:Auralis8D.UI.ViewModels"
        xmlns:diag="clr-namespace:Auralis8D.Core.Diagnostics;assembly=Auralis8D.Core"
        mc:Ignorable="d"
        Title="Auralis 8D — Diagnostics &amp; Debug Log"
        Height="560" Width="800"
        MinHeight="400" MinWidth="600"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BrushBgPrimary}"
        Foreground="{StaticResource BrushTextPrimary}">

    <Window.DataContext>
        <viewmodels:DebugViewModel />
    </Window.DataContext>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" /> <!-- Header & Toolbar -->
            <RowDefinition Height="*" />    <!-- Log Content Box -->
            <RowDefinition Height="Auto" /> <!-- Footer Status -->
        </Grid.RowDefinitions>

        <!-- HEADER & ACTIONS -->
        <Border Grid.Row="0" Margin="0,0,0,12" Padding="0,0,0,12" BorderBrush="{StaticResource BrushBorder}" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Title & Log File Info -->
                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- Terminal Icon -->
                        <Border Width="28" Height="28" Background="{StaticResource BrushBgCard}" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1" CornerRadius="6" Margin="0,0,10,0">
                            <Path HorizontalAlignment="Center" VerticalAlignment="Center"
                                  Data="M 4,6 L 10,12 L 4,18 M 12,18 L 20,18"
                                  Stroke="{StaticResource BrushAccentCyan}" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                        </Border>
                        <TextBlock Text="DIAGNOSTICS &amp; DEBUG LOG" Style="{StaticResource TextHeader}" FontSize="15" VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock Text="{Binding LogFilePath, StringFormat='Log file: {0}'}" Style="{StaticResource TextSubheader}" Margin="0,4,0,0" Foreground="{StaticResource BrushTextMuted}" TextTrimming="CharacterEllipsis" />
                </StackPanel>

                <!-- Action Buttons -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Copy All Button -->
                    <Button Style="{StaticResource ModernButton}" Command="{Binding CopyAllCommand}" Margin="0,0,8,0" Padding="12,6" ToolTip="Copy all diagnostic logs to clipboard">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Path Data="M 16,1 H 4 C 2.9,1 2,1.9 2,3 V 17 H 4 V 3 H 16 V 1 Z M 19,5 H 8 C 6.9,5 6,5.9 6,7 V 21 C 6,22.1 6.9,23 8,23 H 19 C 20.1,23 21,22.1 21,21 V 7 C 21,5.9 20.1,5 19,5 Z M 19,21 H 8 V 7 H 19 V 21 Z"
                                  Width="13" Height="13" Stretch="Uniform" Fill="{StaticResource BrushAccentCyan}" Margin="0,0,6,0" />
                            <TextBlock Text="Copy All Logs" Foreground="{StaticResource BrushAccentCyan}" FontWeight="SemiBold" FontSize="12" />
                        </StackPanel>
                    </Button>

                    <!-- Open Folder Button -->
                    <Button Style="{StaticResource ModernButton}" Command="{Binding OpenLogFolderCommand}" Margin="0,0,8,0" Padding="10,6" ToolTip="Open folder containing diagnostics.log">
                        <TextBlock Text="Open Log File" Style="{StaticResource TextLabel}" FontSize="12" />
                    </Button>

                    <!-- Clear Logs Button -->
                    <Button Style="{StaticResource ModernButton}" Command="{Binding ClearCommand}" Padding="10,6" ToolTip="Clear in-memory log view">
                        <TextBlock Text="Clear" Style="{StaticResource TextLabel}" FontSize="12" />
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- LOG VIEWER LIST -->
        <Border Grid.Row="1" Background="{StaticResource BrushBgSecondary}" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1" CornerRadius="6" Padding="6">
            <ListBox x:Name="LogListBox"
                     ItemsSource="{Binding Logs}"
                     Background="Transparent"
                     BorderThickness="0"
                     ScrollViewer.HorizontalScrollBarVisibility="Auto"
                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                     ScrollViewer.CanContentScroll="True"
                     VirtualizingStackPanel.IsVirtualizing="True"
                     VirtualizingStackPanel.VirtualizationMode="Recycling">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Padding" Value="4,2" />
                        <Setter Property="Margin" Value="0,1" />
                        <Setter Property="Background" Value="Transparent" />
                        <Setter Property="BorderThickness" Value="0" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}" CornerRadius="3">
                                        <ContentPresenter />
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#1A283C" />
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </ListBox.ItemContainerStyle>

                <ListBox.ItemTemplate>
                    <DataTemplate DataType="{x:Type diag:LogEntry}">
                        <StackPanel Orientation="Vertical">
                            <StackPanel Orientation="Horizontal">
                                <!-- Timestamp -->
                                <TextBlock Text="{Binding Timestamp, StringFormat='[{0:HH:mm:ss.fff}]'}"
                                           FontFamily="Consolas" FontSize="12"
                                           Foreground="{StaticResource BrushTextMuted}"
                                           Margin="0,0,8,0" />

                                <!-- Level Tag -->
                                <Border CornerRadius="3" Padding="4,1" Margin="0,0,8,0" VerticalAlignment="Center">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="#1E3A5F" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Level}" Value="{x:Static diag:LogLevel.Warning}">
                                                    <Setter Property="Background" Value="#5C4700" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Level}" Value="{x:Static diag:LogLevel.Error}">
                                                    <Setter Property="Background" Value="#5C1D1D" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock FontFamily="Consolas" FontSize="11" FontWeight="Bold">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Text" Value="INFO" />
                                                <Setter Property="Foreground" Value="{StaticResource BrushAccentCyan}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Level}" Value="{x:Static diag:LogLevel.Warning}">
                                                        <Setter Property="Text" Value="WARN" />
                                                        <Setter Property="Foreground" Value="#FBBF24" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Level}" Value="{x:Static diag:LogLevel.Error}">
                                                        <Setter Property="Text" Value="ERR" />
                                                        <Setter Property="Foreground" Value="#F87171" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Border>

                                <!-- Component Tag -->
                                <TextBlock Text="{Binding Component, StringFormat='[{0}]'}"
                                           FontFamily="Consolas" FontSize="12" FontWeight="SemiBold"
                                           Foreground="{StaticResource BrushSilverBright}"
                                           Margin="0,0,8,0" />

                                <!-- Log Message -->
                                <TextBlock Text="{Binding Message}"
                                           FontFamily="Consolas" FontSize="12"
                                           Foreground="{StaticResource BrushTextPrimary}"
                                           TextWrapping="Wrap" />
                            </StackPanel>

                            <!-- Exception Stack Trace if available -->
                            <TextBlock Text="{Binding ExceptionDetails}"
                                       FontFamily="Consolas" FontSize="11"
                                       Foreground="#FCA5A5"
                                       Margin="24,2,0,2"
                                       TextWrapping="Wrap">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Visible" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ExceptionDetails}" Value="{x:Null}">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>

        <!-- FOOTER: STATUS NOTIFICATION & AUTO-SCROLL TOGGLE -->
        <Grid Grid.Row="2" Margin="0,8,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Temporary Notification Text -->
            <TextBlock Grid.Column="0" Text="{Binding StatusNotification}"
                       Style="{StaticResource TextSubheader}"
                       Foreground="{StaticResource BrushAccentCyan}"
                       VerticalAlignment="Center" />

            <!-- Auto-scroll checkbox -->
            <CheckBox Grid.Column="1" IsChecked="{Binding AutoScroll}"
                      Content="Auto-scroll to latest"
                      Foreground="{StaticResource BrushSilver}"
                      FontFamily="Segoe UI" FontSize="12"
                      VerticalAlignment="Center" />
        </Grid>
    </Grid>
</Window>
